    col1, col2, col3 = st.columns(3)

    with col1:
        cant_minimalistas = st.number_input(
            "Minimalistas/Línea Fina\n(S/ 80 promedio)",
            min_value=0,
            value=10,
            key="cant_minimalistas"
        )

    with col2:
        cant_medianos = st.number_input(
            "Medianos/Sombras\n(S/ 250 promedio)",
            min_value=0,
            value=4,
            key="cant_medianos"
        )

    with col3:
        cant_grandes = st.number_input(
            "Grandes/Completas\n(S/ 600 promedio)",
            min_value=0,
            value=2,
            key="cant_grandes"
        )

    ingreso_minimalistas = cant_minimalistas * 80
    ingreso_medianos = cant_medianos * 250
    ingreso_grandes = cant_grandes * 600
    ingreso_total = ingreso_minimalistas + ingreso_medianos + ingreso_grandes
    costo_insumos = ingreso_total * 0.18
    ganancia_neta = ingreso_total - costo_insumos

    st.markdown("---")

    m1, m2, m3 = st.columns(3)
    with m1:
        st.metric("Ingreso Bruto", f"S/ {ingreso_total:,.2f}")
    with m2:
        st.metric("Gastos Insumos (18%)", f"S/ {costo_insumos:,.2f}")
    with m3:
        st.metric("Ganancia Neta Mensual", f"S/ {ganancia_neta:,.2f}")

    st.markdown("### 📊 Desglose de Ingresos")
    import pandas as pd
    chart_data = pd.DataFrame({
        "Categoría": ["Minimalistas", "Medianos", "Grandes"],
        "Ingresos (S/)": [ingreso_minimalistas, ingreso_medianos, ingreso_grandes]
    })
    st.bar_chart(chart_data.set_index("Categoría"))

    st.info(f"💡 Si trabajas **4 semanas/mes**, tu ganancia potencial es de **S/ {ganancia_neta * 12:,.2f} anuales**.")

